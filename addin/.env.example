# Monlam AI Studio API Key Configuration
#
# IMPORTANT: The API key is NOT bundled at build time (see webpack.config.js).
# For production the key is loaded at runtime from `config.json` next to the
# bundle (gitignored — see config.example.json).  This file is only used by
# the local dev server and is never embedded in the compiled output.
REACT_APP_MONLAM_API_KEY=REPLACE_WITH_YOUR_MONLAM_API_KEY
